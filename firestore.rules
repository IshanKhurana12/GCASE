rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      // Replace with your admin email (same as VITE_ADMIN_EMAIL).
      return request.auth != null && request.auth.token.email == 'admin@yourshop.com';
    }

    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Document id = the 10-digit number. Visitors can look up ONE number
    // (get) but can never list the others. Only the admin can list/edit.
    match /allowedNumbers/{phone} {
      allow get: if true;
      allow list, create, update, delete: if isAdmin();
    }
  }
}
